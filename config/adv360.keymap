#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

// layers
#define BAS 0
#define LEF 1
#define RIG 2
#define SYS 3

/ {
    behaviors {
        bhm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        shm: shift_hr_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RIG LEF>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷    ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷
    &kp EQUAL   &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp C_MUTE                                                       &rgb_ug RGB_TOG &kp N6  &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS
    &kp PLUS    &kp Q       &kp W       &kp E       &kp R       &kp T       &kp C_VOL_UP                                                     &bl BL_TOG  &kp Y       &kp U       &kp I       &kp O       &kp P       &kp PIPE
    &mt LCTRL ESC &bhm LGUI A  &bhm LCTRL S  &bhm LALT D  &shm LSHIFT F &kp G &kp C_VOL_DN &kp LSHFT &kp LALT        &kp RALT    &kp RSHFT   &out OUT_TOG &kp H &shm RSHIFT J &bhm LALT K &bhm RCTRL L &bhm RGUI SEMI &kp EQUAL
    &mt LSHFT MINUS &kp Z   &kp X       &kp C       &kp V       &kp B                               &kp LGUI         &kp RGUI                           &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp GRAVE
    &lt 3 PLUS  &kp GRAVE   &kp CAPS    &kp LEFT    &kp RIGHT               &lt 1 SPACE &kp BSPC    &kp TAB          &kp GRAVE   &kp SQT     &lt 2 ENTER             &kp LBKT    &kp RBKT    &kp LBRC    &kp RBRC    &kp UNDER
            >;
        };

        left_layer {
            display-name = "LEF";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷    ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷
    &kp F12     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &trans                                                           &trans      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
    &trans      &kp EXCL    &kp AT      &kp POUND   &kp DOLLAR  &kp PERCENT &trans                                                           &trans      &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR    &trans
    &trans      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &trans      &trans      &trans           &trans      &trans      &trans      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &trans
    &trans      &kp MINUS   &kp PLUS    &kp PERIOD  &kp COLON   &kp UNDER                           &trans           &trans                              &kp BSLH    &kp LBKT    &kp LT      &kp GT      &kp QMARK   &kp TILDE
    &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans           &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans
            >;
        };

        right_layer {
            display-name = "RIG";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷    ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷
    &kp F12     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &trans                                                           &trans      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
    &trans      &trans      &trans      &trans      &trans      &trans      &trans                                                           &trans      &trans      &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans           &trans      &trans      &trans      &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans                              &trans           &trans                              &trans      &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans                  &trans      &trans      &trans           &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans
            >;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷    ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷           ╷
    &trans      &trans      &trans      &trans      &trans      &trans      &trans                                                           &trans      &trans      &trans      &trans      &trans      &trans      &bt BT_CLR
    &kp F12     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &bootloader                                                      &bootloader &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
    &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans      &bl BL_INC  &bl BL_DEC       &out OUT_USB &out OUT_BLE &out OUT_TOG &trans   &trans      &trans      &trans      &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans                              &trans           &trans                              &trans      &trans      &trans      &trans      &trans      &trans
    &stp STP_BAT &trans     &trans      &trans      &trans                  &trans      &trans      &trans           &trans      &trans      &trans                  &trans      &trans      &trans      &trans      &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
